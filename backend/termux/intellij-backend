#!/data/data/com.termux/files/usr/bin/bash
# Starts, stops and reports IntelliJ's remote-dev backend in Termux.
#
#   intellij-backend start <project> [--lan] [--port N]   start (or find) the backend; prints its join link
#   intellij-backend link                                   prints the running backend's join link
#   intellij-backend status [--json]                        running or not, project, port, join link
#   intellij-backend stop                                   stops the running backend
#   intellij-backend setup                                  one-time setup in Termux (safe to repeat)
#
# Exit codes: 0 ok, 1 failed, 2 usage, 3 not running, 4 another IntelliJ uses the same settings.
#
# The Android app calls this through Termux's RUN_COMMAND and over SSH, so the output and exit
# codes are a contract: docs/connections.md. The state comes from IntelliJ's own status files in
# ~/.cache/JetBrains/RemoteDev/active/ (one per running backend, named by its PID), the same files
# JetBrains Gateway reads over SSH.
#
# While a backend runs, Termux:API shows an ongoing notification with a Stop button (needs the
# Termux:API app; without it the backend still runs, just without the notification). `setup`
# puts a wrapper in place of IntelliJ's bin/remote-dev-server.sh, so this also happens for
# backends that JetBrains Gateway or a hand-typed `remote-dev-server.sh run` starts.
#
# IntelliJ install: $INTELLIJ_HOME, or the only ~/intellij/idea-*/ folder.

set -euo pipefail
shopt -s nullglob

readonly TERMUX_PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
readonly JBR_HOME="$TERMUX_PREFIX/lib/jvm/jbr-25"
readonly STATUS_DIR="$HOME/.cache/JetBrains/RemoteDev/active"
readonly LOG_DIR="$HOME/.local/state/intellij-backend"
readonly DEFAULT_PORT=5990
readonly START_TIMEOUT_SECONDS=180
readonly STOP_TIMEOUT_SECONDS=60
readonly NOTIFICATION_ID="intellij-backend"
readonly ANDROID_APP_ACTIVITY="intellijandroid.client.android/.MainActivity"
# setup moves IntelliJ's launcher here and puts a wrapper in its place.
readonly REAL_LAUNCHER_NAME="remote-dev-server.real.sh"
readonly WRAPPER_MARKER="Written by intellij-backend setup"
readonly FSNOTIFIER_PATH="$HOME/intellij/fsnotifier"

# Every IntelliJ command here (run and stop) needs our bionic JBR: IntelliJ's bundled JBR is
# built for glibc and fails at once (/lib/ld-linux-aarch64.so.1: not found). Set here, not in
# the shell profile, because Termux's RUN_COMMAND doesn't read one.
export IDEA_JDK="$JBR_HOME"
export REMOTE_DEV_SERVER_USE_SELF_CONTAINED_LIBS=0
# Android has no writable /tmp; Termux sets TMPDIR in its own sessions, not always elsewhere.
export TMPDIR="${TMPDIR:-$TERMUX_PREFIX/tmp}"

readonly EXIT_FAILED=1
readonly EXIT_USAGE=2
readonly EXIT_NOT_RUNNING=3
readonly EXIT_CONFLICT=4

fail() {
	local -r exit_code="$1"
	shift
	echo "intellij-backend: $*" >&2
	exit "$exit_code"
}

usage() {
	sed -n '4,8s/^# \{0,1\}//p' "$0" >&2
	exit "$EXIT_USAGE"
}

intellij_launcher() {
	local intellij_home="${INTELLIJ_HOME:-}"
	if [[ -z "$intellij_home" ]]; then
		local -a candidates=("$HOME"/intellij/idea-*/)
		if [[ ${#candidates[@]} -ne 1 ]]; then
			fail "$EXIT_FAILED" "found ${#candidates[@]} IntelliJ installs under ~/intellij; set INTELLIJ_HOME to one"
		fi
		intellij_home="${candidates[0]%/}"
	fi
	local -r launcher="$intellij_home/bin/remote-dev-server.sh"
	[[ -x "$launcher" ]] || fail "$EXIT_FAILED" "not an IntelliJ install (no bin/remote-dev-server.sh): $intellij_home"
	echo "$launcher"
}

# Prints the status file of the running backend, if any. Files whose process is gone (a crash
# leaves them behind) don't count.
running_status_file() {
	local status_file
	for status_file in "$STATUS_DIR"/*; do
		if [[ -d "/proc/$(basename "$status_file")" ]] && jq -e '.joinLink' "$status_file" >/dev/null 2>&1; then
			echo "$status_file"
			return
		fi
	done
}

# The join link written when the backend started. Valid until the first client connects with it.
join_link_of() {
	jq -r '.joinLink' "$1"
}

# A join token works once: when a client connects with it, the backend issues a new one, but the
# status file keeps the old one. So ask the backend itself with IntelliJ's status command (about
# 1.5 s; it doesn't use up the token). Prints its JSON: joinLink, projects[].controllerConnected.
live_status_json() {
	local -r status_file="$1"
	local output
	output="$(timeout 30 "$(intellij_launcher)" status "$(project_of "$status_file")" 2>/dev/null)" || true
	output="$(sed -n '/^{/,/^}/p' <<<"$output")"
	jq -e '.joinLink' <<<"$output" >/dev/null 2>&1 \
		|| fail "$EXIT_FAILED" "the backend (pid $(basename "$status_file")) didn't answer IntelliJ's status command"
	echo "$output"
}

project_of() {
	jq -r '.gatewayLink | capture("projectPath=(?<path>[^&]+)").path | @urid' "$1"
}

# Any IntelliJ JVM: a backend, or the desktop IntelliJ in XFCE. They share the config and
# system folders, so only one can run.
other_intellij_pid() {
	pgrep -f 'com\.intellij\.idea\.Main' | head -n 1 || true
}

# termux-notification waits forever when the Termux:API app is missing, hence the timeout.
show_notification() {
	local -r project_name="$1"
	timeout 10 termux-notification \
		--id "$NOTIFICATION_ID" \
		--ongoing \
		--alert-once \
		--priority low \
		--title "IntelliJ backend running" \
		--content "$project_name" \
		--action "am start -n $ANDROID_APP_ACTIVITY" \
		--button1 "Stop" \
		--button1-action "$TERMUX_PREFIX/bin/intellij-backend stop" \
		>/dev/null 2>&1 || true
}

release_backend_resources() {
	timeout 10 termux-notification-remove "$NOTIFICATION_ID" >/dev/null 2>&1 || true
	termux-wake-unlock 2>/dev/null || true
}

# The backend's parent, for every way it starts (start, the launcher wrapper for Gateway or by
# hand): takes the wake lock, shows the notification, runs IntelliJ's launcher, waits for it, then
# removes the notification and releases the wake lock. The launcher outlives IntelliJ's own
# restarts (exit code 88 starts a new JVM) and exits only when the backend is gone for good:
# stop, crash, or killed by Android.
command_run() {
	[[ $# -ge 1 ]] || usage
	local -r launcher="$1"
	shift
	# `run <project> [options]`; without a project IntelliJ opens none.
	local project_name="no project"
	[[ $# -ge 1 && "$1" != -* ]] && project_name="$(basename "$1")"
	# Tells the launcher wrapper that this is already the parent.
	export INTELLIJ_BACKEND_RUN=1
	# Keeps Android from suspending Termux while the screen is off.
	termux-wake-lock 2>/dev/null || true
	show_notification "$project_name"
	"$launcher" run "$@" || true
	release_backend_resources
}

# In place of IntelliJ's bin/remote-dev-server.sh: sets our JBR for every command (Gateway runs
# status, registerBackendLocationForGateway and others too) and sends `run` through
# `intellij-backend internal-run`. Rewritten on every setup; a launcher without the marker is
# IntelliJ's own (a fresh or updated install) and is moved aside first.
install_launcher_wrapper() {
	local -r intellij_bin="$1"
	local -r launcher="$intellij_bin/remote-dev-server.sh"
	if ! grep -qF "$WRAPPER_MARKER" "$launcher"; then
		mv "$launcher" "$intellij_bin/$REAL_LAUNCHER_NAME"
	fi
	[[ -x "$intellij_bin/$REAL_LAUNCHER_NAME" ]] || fail "$EXIT_FAILED" "IntelliJ's launcher is missing: $intellij_bin/$REAL_LAUNCHER_NAME"
	cat >"$launcher" <<EOF
#!$TERMUX_PREFIX/bin/sh
# $WRAPPER_MARKER (backend/termux/intellij-backend in intellij-backend-android).
# IntelliJ's own launcher is $REAL_LAUNCHER_NAME next to this file. This sets the Android JBR for
# every command, and runs "run" under intellij-backend, which shows the notification while the
# backend runs.
export IDEA_JDK="$JBR_HOME"
export REMOTE_DEV_SERVER_USE_SELF_CONTAINED_LIBS=0
export TMPDIR="\${TMPDIR:-$TERMUX_PREFIX/tmp}"
export REMOTE_DEV_LAUNCHER_NAME_FOR_USAGE="\${REMOTE_DEV_LAUNCHER_NAME_FOR_USAGE:-remote-dev-server.sh}"
real_launcher="\$(dirname "\$0")/$REAL_LAUNCHER_NAME"
if [ "\${1:-}" = run ] && [ -z "\${INTELLIJ_BACKEND_RUN:-}" ]; then
	shift
	exec "$TERMUX_PREFIX/bin/intellij-backend" internal-run "\$real_launcher" "\$@"
fi
exec "\$real_launcher" "\$@"
EOF
	chmod 755 "$launcher"
	echo "IntelliJ's launcher wrapped: $launcher"
}

use_android_fsnotifier() {
	local -r intellij_home="$1"
	if [[ ! -x "$FSNOTIFIER_PATH" ]]; then
		echo "No $FSNOTIFIER_PATH: IntelliJ will find file changes by rescanning (see docs/fsnotifier.md)"
		return
	fi
	local -r data_directory_name="$(jq -r '.dataDirectoryName' "$intellij_home/product-info.json")"
	local -r properties_file="$HOME/.config/JetBrains/$data_directory_name/idea.properties"
	local -r property="idea.filewatcher.executable.path=$FSNOTIFIER_PATH"
	mkdir -p "$(dirname "$properties_file")"
	touch "$properties_file"
	if ! grep -qxF "$property" "$properties_file"; then
		sed -i '/^idea\.filewatcher\.executable\.path=/d' "$properties_file"
		echo "$property" >>"$properties_file"
	fi
	echo "File watcher: $FSNOTIFIER_PATH (in $properties_file)"
}

# Lets Gateway over SSH use this install instead of downloading its own (glibc) IntelliJ. IntelliJ's
# command exits with an error when the install is already registered, so check its links first.
register_with_gateway() {
	local -r launcher="$1" intellij_home="$2"
	local link
	for link in "$HOME/.cache/JetBrains/RemoteDev/userProvidedDist"/*; do
		if [[ "$(readlink "$link")" == "$intellij_home" ]]; then
			echo "Registered with JetBrains Gateway: $intellij_home"
			return
		fi
	done
	"$launcher" registerBackendLocationForGateway >/dev/null 2>&1 \
		|| fail "$EXIT_FAILED" "registerBackendLocationForGateway failed; run it by hand to see why: $launcher registerBackendLocationForGateway"
	echo "Registered with JetBrains Gateway: $intellij_home"
}

command_setup() {
	[[ $# -eq 0 ]] || usage
	[[ -x "$JBR_HOME/bin/java" ]] || fail "$EXIT_FAILED" "jbr-25 is not installed ($JBR_HOME): apt install ./jbr-25_*_aarch64.deb"
	local -a missing_packages=()
	command -v jq >/dev/null || missing_packages+=(jq)
	command -v termux-notification >/dev/null || missing_packages+=(termux-api)
	if [[ ${#missing_packages[@]} -gt 0 ]]; then
		echo "Installing ${missing_packages[*]}"
		pkg install -y "${missing_packages[@]}"
	fi
	local -r launcher="$(intellij_launcher)"
	local -r intellij_bin="$(dirname "$launcher")"
	local -r intellij_home="$(dirname "$intellij_bin")"

	install_launcher_wrapper "$intellij_bin"
	use_android_fsnotifier "$intellij_home"
	register_with_gateway "$launcher" "$intellij_home"

	echo
	echo "Left to you (Android settings this script can't change):"
	if ! grep -qE '^[[:space:]]*allow-external-apps[[:space:]]*=[[:space:]]*true' "$HOME/.termux/termux.properties" 2>/dev/null; then
		echo "- For the Android app: allow-external-apps = true in ~/.termux/termux.properties, then termux-reload-settings"
	fi
	echo "- Termux and Termux:API: battery usage Unrestricted (Termux asks the first time it takes a wake lock)"
	echo "- Android 14+: Developer options > Disable child process restrictions, so Android doesn't kill the backend"
	echo "- Termux:API app installed (F-Droid or GitHub, same source as Termux), for the notification"
}

command_start() {
	local project="" listen_address="127.0.0.1" port="$DEFAULT_PORT"
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--lan) listen_address="0.0.0.0" ;;
			--port)
				[[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || fail "$EXIT_USAGE" "--port needs a number"
				port="$2"
				shift
				;;
			-*) usage ;;
			*)
				[[ -z "$project" ]] || usage
				project="$1"
				;;
		esac
		shift
	done
	[[ -n "$project" ]] || usage
	[[ -d "$project" ]] || fail "$EXIT_FAILED" "project folder not found: $project"
	project="$(realpath "$project")"
	[[ -x "$JBR_HOME/bin/java" ]] || fail "$EXIT_FAILED" "jbr-25 is not installed ($JBR_HOME)"
	local -r launcher="$(intellij_launcher)"

	local status_file
	status_file="$(running_status_file)"
	if [[ -n "$status_file" ]]; then
		local -r running_project="$(project_of "$status_file")"
		if [[ "$running_project" == "$project" ]]; then
			local live_status
			live_status="$(live_status_json "$status_file")"
			jq -r '.joinLink' <<<"$live_status"
			return
		fi
		fail "$EXIT_CONFLICT" "a backend for $running_project is running; stop it first"
	fi
	local -r other_pid="$(other_intellij_pid)"
	[[ -z "$other_pid" ]] || fail "$EXIT_CONFLICT" "another IntelliJ is running (pid $other_pid), e.g. the desktop IntelliJ"

	mkdir -p "$LOG_DIR"
	local -r log_file="$LOG_DIR/backend-$(date +%Y%m%d-%H%M%S).log"
	# setsid: its own session, so it outlives the SSH session or Termux command that started it.
	setsid "$0" internal-run "$launcher" "$project" --listenOn "$listen_address" --port "$port" \
		</dev/null >"$log_file" 2>&1 &
	local -r launcher_pid=$!

	local waited_seconds=0
	while [[ $waited_seconds -lt $START_TIMEOUT_SECONDS ]]; do
		status_file="$(running_status_file)"
		if [[ -n "$status_file" && "$(project_of "$status_file")" == "$project" ]]; then
			join_link_of "$status_file"
			return
		fi
		if ! kill -0 "$launcher_pid" 2>/dev/null; then
			tail -n 20 "$log_file" >&2
			fail "$EXIT_FAILED" "the backend exited during startup; log: $log_file"
		fi
		sleep 2
		waited_seconds=$((waited_seconds + 2))
	done
	# Nothing half-started is left behind.
	command_stop >/dev/null 2>&1 || true
	# The whole process group: our parent, IntelliJ's launcher and its JVM.
	kill -- "-$launcher_pid" 2>/dev/null || true
	fail "$EXIT_FAILED" "no join link after ${START_TIMEOUT_SECONDS}s; stopped it. Log: $log_file"
}

command_link() {
	[[ $# -eq 0 ]] || usage
	local -r status_file="$(running_status_file)"
	[[ -n "$status_file" ]] || fail "$EXIT_NOT_RUNNING" "no backend is running"
	local live_status
	live_status="$(live_status_json "$status_file")"
	jq -r '.joinLink' <<<"$live_status"
}

command_status() {
	local json=false
	case "${1:-}" in
		--json) json=true ;;
		"") ;;
		*) usage ;;
	esac
	local -r status_file="$(running_status_file)"
	if [[ -z "$status_file" ]]; then
		if $json; then echo '{"running":false}'; else echo "not running"; fi
		return
	fi
	local live_status
	live_status="$(live_status_json "$status_file")"
	local -r join_link="$(jq -r '.joinLink' <<<"$live_status")"
	# A backend takes one client at a time: a new one with a valid token disconnects this one.
	local -r controller_connected="$(jq '[.projects[]?.controllerConnected] | any' <<<"$live_status")"
	local -r project="$(project_of "$status_file")"
	# tcp://127.0.0.1:5990#jt=… → 127.0.0.1, 5990
	[[ "$join_link" =~ ^[a-z-]+://([^:/#]+):([0-9]+) ]] || fail "$EXIT_FAILED" "unexpected join link in $status_file"
	local -r listen_address="${BASH_REMATCH[1]}" port="${BASH_REMATCH[2]}"
	if $json; then
		jq -cn \
			--arg project "$project" \
			--argjson port "$port" \
			--arg listenOn "$listen_address" \
			--arg joinLink "$join_link" \
			--argjson controllerConnected "$controller_connected" \
			'{running: true, project: $project, port: $port, listenOn: $listenOn, joinLink: $joinLink, controllerConnected: $controllerConnected}'
	else
		echo "running: $project on $listen_address:$port (pid $(basename "$status_file")); client connected: $controller_connected"
		echo "$join_link"
	fi
}

command_stop() {
	[[ $# -eq 0 ]] || usage
	local -r status_file="$(running_status_file)"
	if [[ -n "$status_file" ]]; then
		local -r backend_pid="$(basename "$status_file")"
		local -r project="$(project_of "$status_file")"
		echo "Stopping the backend for $project (pid $backend_pid)" >&2
		# IntelliJ's own stop: asks the backend to save and exit.
		local stop_output
		if ! stop_output="$("$(intellij_launcher)" stop "$project" 2>&1)"; then
			echo "$stop_output" | tail -n 5 >&2
			echo "IntelliJ's stop command failed; waiting ${STOP_TIMEOUT_SECONDS}s, then ending the process" >&2
		fi
		local waited_seconds=0
		while [[ -d "/proc/$backend_pid" && $waited_seconds -lt $STOP_TIMEOUT_SECONDS ]]; do
			sleep 1
			waited_seconds=$((waited_seconds + 1))
		done
		if [[ -d "/proc/$backend_pid" ]]; then
			echo "Still running after ${STOP_TIMEOUT_SECONDS}s; sending SIGTERM" >&2
			kill "$backend_pid" 2>/dev/null || true
			sleep 5
			[[ ! -d "/proc/$backend_pid" ]] || fail "$EXIT_FAILED" "backend (pid $backend_pid) did not stop"
		fi
	fi
	release_backend_resources
}

main() {
	[[ $# -ge 1 ]] || usage
	local -r command="$1"
	shift
	# setup installs jq itself.
	[[ "$command" == setup ]] || command -v jq >/dev/null || fail "$EXIT_FAILED" "jq is required: pkg install jq (or run intellij-backend setup)"
	case "$command" in
		start) command_start "$@" ;;
		link) command_link "$@" ;;
		status) command_status "$@" ;;
		stop) command_stop "$@" ;;
		setup) command_setup "$@" ;;
		# internal: started by start, see command_run
		internal-run) command_run "$@" ;;
		-h | --help | help) usage ;;
		*) usage ;;
	esac
}

main "$@"
